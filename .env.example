# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/verifier_api"

# Admin Authentication
ADMIN_SECRET=change-this-secret-key

# AI OCR (Mistral)
MISTRAL_API_KEY=your_mistral_api_key

# Proxies & Fallbacks (for foreign VPS deployments)
SKIP_PRIMARY_VERIFICATION=false
MPESA_PROXY_KEY=
TELEBIRR_PROXY_KEY=
FALLBACK_PROXIES=
